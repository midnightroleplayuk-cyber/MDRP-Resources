{
    "minigames": {
        "bagging": {
            "guide": "Grab baggies out of the dispenser\nDrag the weed buds into the baggies\n~c~Hold ~INPUT_JUMP~ to exit/finish"
        },
        "collecting": {
            "guide": "Hold ~INPUT_ATTACK~ on the buds to collect\nHold ~INPUT_AIM~ to look around\n~c~Hold ~INPUT_JUMP~ to exit/finish"
        },
        "fertilizing": {
            "guide": "Click ~INPUT_ATTACK~ on the bottle to fertilize\n~c~Hold ~INPUT_JUMP~ to exit/finish"
        },
        "pressing": {
            "guide": "Click ~INPUT_ATTACK~ on the buds to add to press\n~c~Hold ~INPUT_JUMP~ to exit/finish"
        },
        "rolling": {
            "guide": "Drop weed buds into the grinder\nDrag ground weed into the rolling papers\n~c~Hold ~INPUT_JUMP~ to exit/finish"
        },
        "watering": {
            "guide": "Water the soil evenly\n~c~Hold ~INPUT_JUMP~ to exit/finish"
        },
        "spraying": {
            "guide": "Click ~INPUT_ATTACK~ on all the brown spots on the plant\n~c~Hold ~INPUT_JUMP~ to exit/finish"
        }
    },
