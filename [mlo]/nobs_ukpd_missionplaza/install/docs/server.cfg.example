# Mission Plaza UK Police Station 1.2.3 - NO BS SCRIPTS. Add these lines to your own server.cfg.
# Game build 2545 or newer. Keep exactly one sv_enforceGameBuild line in your server.cfg.
sv_enforceGameBuild 2545

# Armoury weapon display (local weapon objects on the armoury racks). 1 = on (the default), 0 = off for everyone.
setr nobs_ukpd_armoury_display 1

# Door closer steps in the F8 console: only while reporting a door that does not close.
# setr nobs_mp_door_debug 1

# The whole station is ONE resource (every setting is in its config.lua):
ensure nobs_ukpd_missionplaza
