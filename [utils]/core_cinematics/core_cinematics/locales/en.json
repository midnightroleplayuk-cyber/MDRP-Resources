    "tutorial": {
        "step_count": "Step {current} of {total}",
        "finish": "Finish",
        "skip": "Skip tutorial",
        "s1_title": "Welcome to Core Cinematics",
        "s1_body": "We'll walk through the basics. First, open the <b>Recording</b> panel from the side menu.",
        "s1_hint": "Click the highlighted item.",
        "s2_title": "Start a recording",
        "s2_body": "Click <b>Start Recording</b>. We'll spawn you in an Adder so you have something to film — just drive around for a few seconds.",
        "s2_hint": "Click the red button.",
        "s3_title": "Drive, then stop",
        "s3_body": "Drive around for a few seconds. When you're done, press <b style=\"color:#4a9df0\">BACKSPACE</b> to save the recording. You can always delete it later from the UI.",
        "s3_hint": "Press BACKSPACE to save.",
        "s4_title": "Add your first keyframe",
        "s4_body": "Click <b>Add Keyframe</b> to create one at frame 0. We'll position its camera in the next step.",
        "s4_hint": "Click Add Keyframe.",
        "s5_title": "Position this keyframe's camera",
        "s5_body": "Click <b>Position Camera</b>, fly with <b>WASD</b> + mouse, then press <b>ENTER</b> to save.<br><br><span style=\"color:#ff5252;font-weight:600\">⚠ Important:</span> <span style=\"color:#ff7070\">fly around and actually find the car — if you don't frame it, the shot will look like ass.</span>",
        "s5_hint": "Find the car, then save.",
        "s6_title": "Scrub the timeline",
        "s6_body": "Drag the playhead forward a second or two so your next keyframe lands later.",
        "s6_hint": "Drag the playhead.",
        "s7_title": "Add a second keyframe",
        "s7_body": "Click <b>Add Keyframe</b> again to create one at the new time.",
        "s7_hint": "Click Add Keyframe.",
        "s8_title": "Reposition it",
        "s8_body": "Open <b>Position Camera</b> and pick a different angle on the car.<br><br><span style=\"color:#ff5252;font-weight:600\">⚠</span> <span style=\"color:#ff7070\">Frame the car again — a shot with nothing in it is a wasted keyframe.</span>",
        "s8_hint": "New angle on the car.",
        "s9_title": "Scrub further",
        "s9_body": "Drag the playhead forward once more for your third keyframe.",
        "s9_hint": "Drag the playhead.",
        "s10_title": "Add a third keyframe",
        "s10_body": "One more — click <b>Add Keyframe</b>.",
        "s10_hint": "Click Add Keyframe.",
        "s11_title": "Position the last one",
        "s11_body": "One more angle. Three positioned keyframes around the vehicle = a proper little shot.<br><br><span style=\"color:#ff5252;font-weight:600\">⚠</span> <span style=\"color:#ff7070\">Keep the car in frame — if all three shots miss it, the preview will look like ass.</span>",
        "s11_hint": "Final angle on the car.",
        "s12_title": "Back to the main menu",
        "s12_body": "Click the <b>Back</b> button to leave keyframe properties so you can open other panels.",
        "s12_hint": "Click Back.",
        "s13_title": "Open the Interpolation panel",
        "s13_body": "Click <b>Interpolation</b> in the side menu.",
        "s13_hint": "Click Interpolation.",
        "s14_title": "Pick a different mode",
        "s14_body": "Open the <b>Mode</b> dropdown and try another option — <i>Cinematic</i> gives the smoothest motion.",
        "s14_hint": "Change the mode.",
        "s15_title": "Play your shot",
        "s15_body": "Press <b>Space</b> or hit the <b>Play</b> button to watch the keyframes animate together.",
        "s15_hint": "Play, then let it finish (or press Space again).",
        "s16_title": "Tutorial complete.",
        "s16_body": "That's the loop: <b>record → keyframe → position → scrub → interpolate → play</b>. Explore the other panels and build something.",
        "s16_hint": "Click Finish to close."
    },
